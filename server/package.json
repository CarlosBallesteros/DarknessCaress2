{
  "name": "server",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../.env --import tsx src/app.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.copyFileSync('src/config/config.json','dist/config/config.json');fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "migrate": "node dist/db/migrate.js",
    "start": "node dist/app.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
